<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.tychofreeman</groupId>
  <artifactId>java-refactor-mcp</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>java-refactor-mcp</name>
  <description>MCP server giving Claude behavior-preserving Java refactorings, built on Eclipse JDT Core.</description>
  <url>https://github.com/tychofreeman/java-refactor-mcp</url>

  <licenses>
    <license>
      <name>MIT License</name>
    </license>
  </licenses>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- UNVERIFIED: could not reach Maven Central from the build sandbox.
         Confirm both versions against Maven Central before the first build. -->
    <jdt.version>3.40.0</jdt.version>
    <mcp.version>1.0.0</mcp.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencies>
    <!-- Eclipse JDT Core: compiler, AST, bindings, ASTRewrite. Headless use only;
         no workspace, no OSGi runtime. See docs/design.md. -->
    <dependency>
      <groupId>org.eclipse.jdt</groupId>
      <artifactId>org.eclipse.jdt.core</artifactId>
      <version>${jdt.version}</version>
    </dependency>

    <!-- MCP Java SDK (STDIO transport is the one we use). -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-core</artifactId>
      <version>${mcp.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <!-- Golden-case tests run as JUnit tests; keep them in the default run. -->
      </plugin>
    </plugins>
  </build>
</project>
