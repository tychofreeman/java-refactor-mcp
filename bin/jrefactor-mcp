#!/bin/sh
# Starts the java-refactor-mcp server built from this checkout, serving the
# project given as $1 (default: this checkout). Rebuilds the jar first when it
# is missing or older than the sources. Stdout carries the MCP protocol, so the
# build's output goes to stderr.
set -eu

here=$(cd "$(dirname "$0")/.." && pwd)
root=${1:-$here}
jar="$here/target/java-refactor-mcp.jar"

# The build needs a JDK. When JAVA_HOME is unset, take the one javac belongs to:
# the default java may be a runtime without a compiler.
if [ -z "${JAVA_HOME:-}" ] && command -v javac >/dev/null 2>&1; then
  JAVA_HOME=$(dirname "$(dirname "$(readlink -f "$(command -v javac)")")")
  export JAVA_HOME
fi

if [ ! -f "$jar" ] || [ -n "$(find "$here/pom.xml" "$here/src/main" -newer "$jar" -print 2>/dev/null | head -n 1)" ]; then
  echo "jrefactor-mcp: building $jar" >&2
  (cd "$here" && ./mvnw -q -B package -DskipTests) >&2 || {
    echo "jrefactor-mcp: build failed; run ./mvnw package in $here to see why" >&2
    exit 1
  }
fi

exec "${JAVA_HOME:+$JAVA_HOME/bin/}java" -jar "$jar" "$root"
