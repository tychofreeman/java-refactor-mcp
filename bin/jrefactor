#!/bin/sh
# Runs one java-refactor-mcp tool from the command line (see Cli.USAGE, or run
# it with no arguments), with the jar built from this checkout. Rebuilds the jar
# first when it is missing or older than the last commit of its sources, or
# always with --rebuild; the build's output goes to stderr, so stdout carries
# only the result.
set -eu

here=$(cd "$(dirname "$0")/.." && pwd)
jar="$here/target/java-refactor-mcp.jar"

# The build needs a JDK. When JAVA_HOME is unset, take the one javac belongs to:
# the default java may be a runtime without a compiler.
if [ -z "${JAVA_HOME:-}" ] && command -v javac >/dev/null 2>&1; then
  JAVA_HOME=$(dirname "$(dirname "$(readlink -f "$(command -v javac)")")")
  export JAVA_HOME
fi

# Stale means older than the last commit of the tools' code, not than the
# working tree: this command edits src/main itself, and rebuilding after each
# of its own edits cost about 5 s a run. Without git, any newer source counts.
stale() {
  [ ! -f "$jar" ] && return 0
  committed=$(git -C "$here" log -1 --format=%ct -- pom.xml src/main 2>/dev/null) || committed=
  if [ -n "$committed" ]; then
    [ "$committed" -gt "$(stat -c %Y "$jar")" ]
  else
    [ -n "$(find "$here/pom.xml" "$here/src/main" -newer "$jar" -print 2>/dev/null | head -n 1)" ]
  fi
}

# --rebuild (as the first argument) or JREFACTOR_REBUILD=1 builds from the working
# tree first, uncommitted changes included: to probe server code before a commit.
rebuild=${JREFACTOR_REBUILD:-}
if [ "${1:-}" = "--rebuild" ]; then
  rebuild=1
  shift
fi

if [ -n "$rebuild" ] || stale; then
  echo "jrefactor: building $jar" >&2
  (cd "$here" && ./mvnw -q -B package -DskipTests) >&2 || {
    echo "jrefactor: build failed; run ./mvnw package in $here to see why" >&2
    exit 1
  }
fi

exec "${JAVA_HOME:+$JAVA_HOME/bin/}java" -cp "$jar" io.github.tychofreeman.jrefactor.Cli "$@"
